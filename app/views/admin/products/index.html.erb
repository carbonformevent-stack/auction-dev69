<% content_for :title, "คิวรอตรวจสอบ" %>
<% total = @category_counts.values.sum %>
<% sla_hours = Product::REVIEW_SLA.in_hours.to_i %>
<% cards = [
     [ "pending", "รอตรวจสอบ", @stats.pending, false ],
     [ "overdue", "รอเกิน #{sla_hours} ชั่วโมง", @stats.overdue, true ],
     [ "resubmitted", "ส่งใหม่หลังแก้ไข", @stats.resubmitted, false ],
     [ "reviewed_today", "ตรวจแล้ววันนี้", @stats.reviewed_today, false ]
   ] %>

<h1 class="text-[28px] leading-snug font-bold">คิวรอตรวจสอบ</h1>
<p class="mt-1 text-[15px] text-ink-2">เรียงจากส่งก่อน ตรวจรายการที่รอนานที่สุดก่อน</p>

<dl class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3">
  <% cards.each do |key, label, value, warn| %>
    <div data-stat="<%= key %>" data-value="<%= value %>" class="card p-4">
      <dt class="text-sm text-ink-2"><%= label %></dt>
      <dd class="mt-1 text-[28px] leading-none font-bold tabular-nums <%= "text-danger" if warn && value.positive? %>"><%= value %></dd>
    </div>
  <% end %>
</dl>

<% if total.zero? %>
  <div class="empty-state mt-6 bg-surface">
    <h2 class="text-lg font-semibold">ไม่มีสินค้ารอตรวจ</h2>
  </div>
<% else %>
  <nav aria-label="กรองตามประเภท" class="mt-6 flex flex-wrap gap-2">
    <% chips = [ [ "all", "ทั้งหมด", total ] ] + category_options.map { |label, value| [ value, label, @category_counts.fetch(value, 0) ] } %>
    <% chips.each do |key, label, count| %>
      <%= link_to admin_products_path(key == "all" ? {} : { category: key }),
            aria: { current: ("true" if (@category || "all") == key) },
            data: { category_chip: key, count: count },
            class: "chip" do %>
        <%= label %> <span class="tabular-nums"><%= count %></span>
      <% end %>
    <% end %>
  </nav>

  <%# relative: ให้ sr-only (position: absolute) ในตารางถูกกรอบเลื่อนตัด ไม่ดันความกว้างของทั้งหน้า %>
  <div class="card relative mt-4 overflow-x-auto p-0">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">สินค้า</th>
          <th scope="col">ผู้ขาย</th>
          <th scope="col" class="text-right">ราคาเริ่มต้น</th>
          <th scope="col">ใบรับรอง</th>
          <th scope="col" aria-sort="ascending">ส่งเมื่อ <span aria-hidden="true">↑</span></th>
          <th scope="col"><span class="sr-only">การทำงาน</span></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <% overdue = product.review_overdue? %>
          <% round = product.resubmission_round %>
          <tr <%= tag.attributes(data: { overdue: ("true" if overdue) }) %>>
            <td>
              <div class="flex items-center gap-3">
                <%= product_thumb(product.cover_image, alt: "", class_name: "size-12") %>
                <div class="min-w-0">
                  <%= link_to product.title, admin_product_path(product), class: "block max-w-[280px] truncate leading-snug font-semibold text-ink no-underline hover:underline" %>
                  <p class="text-[13px] text-ink-2">
                    <%= category_label(product.category) %> · <%= product.images.size %> รูป<% if round > 1 %> · <strong class="font-semibold text-primary">ส่งใหม่ครั้งที่ <%= round %></strong><% end %>
                  </p>
                </div>
              </div>
            </td>
            <td class="text-sm"><%= product.seller.display_name %></td>
            <td class="text-right font-semibold tabular-nums"><%= baht(product.starting_price) %></td>
            <td class="text-sm text-ink-2"><%= product.certificate.attached? ? "มี PDF" : "—" %></td>
            <td>
              <p class="text-sm"><%= thai_short_time(product.submitted_at) %></p>
              <p class="text-[13px] <%= overdue ? "font-semibold text-danger" : "text-ink-2" %>"><%= waiting_time(product.submitted_at) %></p>
            </td>
            <td class="text-right">
              <%= link_to "ตรวจสอบ", admin_product_path(product), aria: { label: "ตรวจสอบ #{product.title}" }, class: "btn-outline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @products.empty? %>
      <p class="border-t border-line px-4 py-10 text-center text-ink-2">ไม่มีสินค้าประเภทนี้ในคิว</p>
    <% end %>
  </div>
<% end %>
