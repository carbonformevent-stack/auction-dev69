<%# locals: (seller:) %>
<% stats = Admin::SellerStats.new(seller) %>
<section class="card">
  <h2 class="text-base font-semibold">ผู้ขาย</h2>
  <div class="mt-3 flex items-center gap-3">
    <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary-soft font-semibold text-primary-ink"><%= avatar_initial(seller) %></span>
    <div class="min-w-0">
      <p class="truncate font-semibold"><%= seller.display_name %></p>
      <p class="text-[13px] text-ink-2">สมาชิกตั้งแต่ <%= thai_month_year_be(seller.created_at) %></p>
    </div>
  </div>
  <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
    <% [ [ "listed", "ลงสินค้า", stats.listed ], [ "approved", "อนุมัติ", stats.approved ], [ "rejected", "ไม่อนุมัติ", stats.rejected ] ].each do |key, label, value| %>
      <div data-seller-stat="<%= key %>" data-value="<%= value %>" class="rounded-lg bg-muted px-2 py-2.5">
        <dd class="text-lg leading-none font-bold tabular-nums"><%= value %></dd>
        <dt class="mt-1 text-xs text-ink-2"><%= label %></dt>
      </div>
    <% end %>
  </dl>
</section>
