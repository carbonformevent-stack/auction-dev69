<% content_for :title, "ตรวจสอบ: #{@product.title}" %>
<% rejection = @product.latest_rejection if @product.rejected? %>
<% position = queue_position(@product) %>
<% round = @product.resubmission_round %>
<% meta = [ category_label(@product.category),
            ("ส่งใหม่ครั้งที่ #{round}" if round > 1),
            (thai_short_time(@product.submitted_at) if @product.submitted_at) ].compact.join(" · ") %>

<%= link_to (position ? "← คิวรอตรวจสอบ (#{position[0]} จาก #{position[1]})" : "← คิวรอตรวจสอบ"), admin_products_path, class: "text-sm" %>

<div class="mt-1 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <p class="text-sm text-ink-2"><%= meta %></p>
    <h1 class="text-[28px] leading-snug font-bold break-words"><%= @product.title %></h1>
  </div>
  <%= status_badge(@product, size: :lg) %>
</div>

<% if @product.approved? %>
  <p role="status" class="mt-4 rounded-xl border border-success/30 bg-success-soft px-5 py-3 text-success-ink"><strong>อนุมัติแล้ว</strong> · สินค้าพร้อมนำไปจัดประมูล</p>
<% elsif @product.rejected? %>
  <p role="status" class="mt-4 rounded-xl border border-danger/30 bg-danger-soft px-5 py-3 text-danger-ink">
    <strong>ไม่อนุมัติแล้ว</strong><% if rejection&.reason.present? %> · ผู้ขายเห็นเหตุผล: “<%= rejection.reason %>”<% end %>
  </p>
<% end %>

<div class="mt-6 flex flex-wrap items-start gap-6">
  <div class="flex min-w-0 flex-[999_1_600px] flex-col gap-6">
    <%= render "products/gallery", product: @product, ratio: "aspect-[4/3]", full_link: true %>
    <%= render "admin/products/certificate", product: @product if @product.certificate.attached? %>
    <%= render "products/description", product: @product, heading: "รายละเอียดจากผู้ขาย" %>
  </div>

  <aside class="flex flex-[1_1_300px] flex-col gap-6 lg:max-w-[380px]">
    <%= render "products/listing_summary", product: @product %>
    <%= render "admin/products/seller_card", seller: @product.seller %>
    <%= render "products/timeline", events: Products::Timeline.new(@product, audience: :admin).events, show_reason: true %>
  </aside>
</div>

<% if @product.pending_review? %>
  <%= render "admin/products/decision", product: @product, reason: @rejection_reason, errors: @rejection_errors || [] %>
<% end %>
