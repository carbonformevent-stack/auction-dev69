<section aria-labelledby="categories-heading" class="border-t border-line">
  <div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <h2 id="categories-heading" class="text-2xl font-bold">เลือกตามหมวด</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% Product.categories.each_key do |category| %>
        <li class="card flex items-center gap-4 p-4">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary-soft text-primary">
            <%= category_icon(category) %>
          </span>
          <div>
            <p class="font-semibold"><%= category_label(category) %></p>
            <p class="text-sm text-ink-2"><%= category_examples(category) %></p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>
