<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= content_for(:title) || "Auction" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Auction">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-canvas font-sans text-base leading-relaxed text-ink">
    <%= yield :mobile_bar %>

    <header class="border-b border-line bg-surface <%= "hidden sm:block" if content_for?(:mobile_bar) %>">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
        <div class="flex items-center gap-3">
          <%= link_to root_path, class: "flex items-center gap-2.5 text-lg font-bold text-ink no-underline" do %>
            <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-lg bg-primary font-bold text-on-primary">ป</span>
            ประมูลสินค้าสะสม
          <% end %>
          <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent-ink">Beta</span>
          <% if admin_area? %>
            <span class="rounded-full bg-ink px-2.5 py-0.5 text-xs font-semibold text-surface">แอดมิน</span>
          <% end %>
        </div>

        <% if user_signed_in? %>
          <div class="flex items-center gap-2">
            <nav aria-label="<%= admin_area? ? "เมนูแอดมิน" : "เมนูหลัก" %>" class="flex flex-wrap items-center gap-1 text-sm font-medium">
              <% if admin_area? %>
                <%= link_to "คิวตรวจสอบ", admin_products_path,
                      aria: { current: ("page" if controller_path.start_with?("admin/products")) },
                      class: nav_link_classes(current: controller_path.start_with?("admin/products")) %>
                <%= link_to "กลับหน้าผู้ใช้", products_path, class: nav_link_classes %>
              <% elsif current_user.admin? %>
                <%= link_to "แอดมิน", admin_products_path, class: nav_link_classes %>
              <% end %>
            </nav>
            <%= render "shared/account_menu", variant: :avatar %>
          </div>
        <% else %>
          <nav aria-label="เมนูหลัก" class="hidden items-center gap-1 text-sm font-medium md:flex">
            <%= link_to "วิธีประมูล", root_path(anchor: "how-it-works"), class: nav_link_classes %>
            <%= link_to "ลงขายสินค้า", new_product_path, class: nav_link_classes %>
            <%= link_to "คำถามที่พบบ่อย", root_path(anchor: "faq"), class: nav_link_classes %>
          </nav>
          <div class="flex items-center gap-2">
            <%= link_to "เข้าสู่ระบบ", new_user_session_path, class: nav_link_classes %>
            <%= link_to "สมัครสมาชิก", new_user_session_path, class: "btn-primary min-h-10 px-4 text-sm" %>
          </div>
        <% end %>
      </div>
    </header>

    <%= render "shared/toasts" %>

    <% if content_for?(:full_width) %>
      <main><%= yield %></main>
    <% else %>
      <main class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6 sm:pt-7">
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/site_footer" %>
  </body>
</html>
