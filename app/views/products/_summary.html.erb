<section class="card">
  <h2 class="mb-3 text-lg font-semibold">ข้อมูลการลงสินค้า</h2>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-[15px]">
    <dt class="text-ink-2">ประเภท</dt><dd><%= category_label(product.category) %></dd>
    <dt class="text-ink-2">ราคาเริ่มต้น</dt><dd class="font-semibold tabular-nums"><%= baht(product.starting_price) %></dd>
    <dt class="text-ink-2">ระยะเวลาที่เสนอ</dt><dd><%= duration_label(product.desired_duration_minutes) %> <span class="text-ink-2">(ค่าแนะนำ)</span></dd>
    <dt class="text-ink-2">รูปภาพ</dt><dd><%= product.images.size %> รูป</dd>
    <dt class="text-ink-2">ใบรับรอง</dt>
    <dd>
      <% if product.certificate.attached? %>
        <%= link_to product.certificate.filename, rails_blob_path(product.certificate, disposition: "inline"), target: "_blank", rel: "noopener" %>
      <% else %>
        ไม่มี
      <% end %>
    </dd>
    <dt class="text-ink-2">ส่งตรวจล่าสุด</dt><dd><%= thai_time(product.submitted_at) %></dd>
  </dl>
</section>
