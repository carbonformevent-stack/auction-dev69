<% content_for :title, @product.title %>

<%= link_to "← สินค้าของฉัน", products_path, class: "text-sm text-primary" %>

<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <p class="text-sm text-ink-2"><%= category_label(@product.category) %></p>
    <h1 class="text-[28px] leading-snug font-bold break-words"><%= @product.title %></h1>
  </div>
  <%= status_badge(@product) %>
</div>

<% if @product.rejected? && (rejection = @product.latest_rejection) %>
  <div role="status" class="mt-4 rounded-xl border border-danger/30 bg-danger-soft px-4 py-3 text-danger-ink">
    <p class="font-semibold">ไม่อนุมัติ — เหตุผลจากทีมตรวจสอบ</p>
    <p class="mt-1 whitespace-pre-line"><%= rejection.reason %></p>
    <p class="mt-1 text-sm">แก้ไขสินค้าแล้วกด "ส่งตรวจอีกครั้ง"</p>
  </div>
<% elsif @product.pending_review? %>
  <p role="status" class="mt-4 rounded-xl border border-line bg-accent-soft px-4 py-3 text-accent-ink">กำลังรอทีมตรวจสอบ — แก้ไขไม่ได้ระหว่างนี้</p>
<% elsif @product.approved? %>
  <p role="status" class="mt-4 rounded-xl border border-success/30 bg-success-soft px-4 py-3 text-success">อนุมัติแล้ว รอ Admin นำไปจัดประมูล</p>
<% end %>

<div class="mt-4 flex flex-wrap gap-3">
  <% if @product.submittable_by?(current_user) %>
    <%= button_to (@product.rejected? ? "ส่งตรวจอีกครั้ง" : "ส่งตรวจ"), product_submission_path(@product), class: "btn-primary cursor-pointer" %>
  <% end %>
  <% if @product.editable_by?(current_user) %>
    <%= link_to "แก้ไข", edit_product_path(@product), class: "btn-secondary" %>
  <% end %>
  <% if @product.destroyable_by?(current_user) %>
    <%= button_to "ลบ", product_path(@product), method: :delete, class: "btn-danger cursor-pointer",
          form: { data: { turbo_confirm: "ลบสินค้านี้? ย้อนกลับไม่ได้" } } %>
  <% end %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_340px]">
  <div class="flex min-w-0 flex-col gap-6">
    <%= render "products/details", product: @product %>
  </div>
  <aside class="flex flex-col gap-6">
    <%= render "products/summary", product: @product %>
    <%= render "products/history", product: @product, show_reviewer: false %>
  </aside>
</div>
