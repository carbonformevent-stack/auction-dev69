<%# locals: (readiness:, product:) %>
<%# แถบขั้นตอน — desktop เป็น 5 ช่อง, มือถือเป็นสรุป "ขั้นที่ n จาก 5" + แถบ 5 ส่วน; สถานะคำนวณจากข้อมูลที่ render ล่าสุด %>
<% steps = readiness.steps %>
<% current_index = steps.index { |step| step.key == readiness.current_step } %>
<% position = (current_index || steps.size - 1) + 1 %>

<ol aria-label="ขั้นตอน" class="mt-5 hidden grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-2 sm:grid">
  <% steps.each_with_index do |step, index| %>
    <% current = step.key == readiness.current_step %>
    <% tone = if step.status == :done then "bg-success-soft font-semibold text-success"
              elsif current then "bg-primary-soft font-semibold text-primary-ink"
              else "bg-muted-2 font-medium text-ink-2"
              end %>
    <li <%= tag.attributes(aria: { current: ("step" if current) }) %> class="rounded-lg px-3 py-2.5 text-sm <%= tone %>">
      <%= index + 1 %> <%= step.label %>
      <% if step.status == :done %><span aria-hidden="true">✓</span><span class="sr-only">เสร็จแล้ว</span><% end %>
      <% if step.key == :images %> · <%= product.images.size %>/<%= Product::MAX_IMAGES %><% end %>
    </li>
  <% end %>
</ol>

<%# -mt-4 หักล้าง padding บนของ <main> ให้แถบติดใต้ app bar ตาม design %>
<div class="-mx-4 -mt-4 border-b border-line bg-surface px-4 py-3 sm:hidden">
  <div class="flex items-center justify-between text-[13px]">
    <span class="font-semibold">ขั้นที่ <%= position %> จาก <%= steps.size %> · <%= steps[position - 1].label %></span>
    <span class="text-ink-2">พร้อมส่ง <%= readiness.done_count %>/<%= readiness.total %></span>
  </div>
  <div role="progressbar" aria-label="ขั้นตอน" aria-valuemin="0" aria-valuemax="<%= steps.size %>" aria-valuenow="<%= readiness.done_count %>"
       class="mt-2 grid grid-cols-5 gap-1">
    <% steps.each do |step| %>
      <span class="h-1 rounded-full <%= step.status == :done ? "bg-success" : (step.key == readiness.current_step ? "bg-primary" : "bg-muted-2") %>"></span>
    <% end %>
  </div>
</div>
