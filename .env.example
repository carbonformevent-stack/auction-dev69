# คัดลอกเป็น .env (ห้าม commit .env) แล้วใส่ค่าจริง
# Keycloak (OpenID Connect)
KEYCLOAK_ISSUER=          # เช่น https://keycloak.example.com/realms/auction
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# production: APP_URL ไม่ต้องตั้ง ถ้ามี APP_HOST (custom domain) หรือ RAILWAY_PUBLIC_DOMAIN
APP_URL=http://localhost:3000

# ล็อกอินจำลองสำหรับ local development (ยังไม่มี Keycloak): ตั้งเป็น 1 แล้วรัน bin/rails db:seed
# ผลคือหน้า /sign_in มีปุ่มเข้าเป็นผู้ขาย/Admin ทดสอบ — ทำงานเฉพาะ development เท่านั้น
DEV_LOGIN=

# Seed: email ของผู้ใช้ที่จะตั้งเป็น admin (ต้อง login ผ่าน Keycloak มาก่อน 1 ครั้ง)
ADMIN_EMAIL=
MAILER_SENDER=
ACTIVE_STORAGE_SERVICE=local   # production default: amazon (S3-compatible)

# Active Storage (S3-compatible / Railway Bucket) — ใช้ใน production
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
